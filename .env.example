# =============================================================================
# personal-agent-system — variáveis de ambiente
#
# COMO USAR
#   1. Copie este arquivo:  cp .env.example .env
#   2. Preencha os valores marcados como OBRIGATÓRIO.
#   3. Suba o sistema:      docker compose up --build
#
# O arquivo .env real NUNCA vai para o Git (está no .gitignore). Este
# .env.example existe justamente para documentar quais variáveis existem
# sem expor nenhum segredo — é o padrão esperado em projeto open source.
# =============================================================================


# ------ LLM Providers --------------------------------------------------------
# OBRIGATÓRIO. Chave da OpenRouter, usada para o Gemini 2.5 Flash (roteador
# e conversa geral), com custo controlado.  ->  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OBRIGATÓRIO. Chave da Anthropic, usada pelo agente de triagem (Claude
# Sonnet).  ->  https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OBRIGATÓRIO se você for usar mensagens de voz. Usada SOMENTE para
# transcrever áudio do Telegram (Whisper). Se ficar vazia, mensagens de
# texto continuam funcionando normalmente; só o áudio falha.
OPENAI_API_KEY=


# ------ Telegram -------------------------------------------------------------
# OBRIGATÓRIO. Token do seu bot, obtido com o @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=

# OBRIGATÓRIO para as notificações proativas (webhook do Trello). É o ID
# numérico da conversa para onde o sistema envia mensagens por conta
# própria. Para descobrir o seu: mande qualquer mensagem ao bot e abra
# https://api.telegram.org/bot<SEU_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=


# ------ Trello ---------------------------------------------------------------
# OBRIGATÓRIOS. Gere os dois em https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_TOKEN=

# OBRIGATÓRIO. ID da lista onde os cards aprovados são criados (o "Backlog").
# Para descobrir: abra o board e acrescente .json na URL, depois procure
# pelo nome da lista dentro do campo "lists".
TRELLO_BACKLOG_LIST_ID=

# As duas variáveis abaixo NÃO são lidas pelo código da aplicação — elas
# são usadas no passo MANUAL de registrar o webhook no Trello (ver README,
# seção "Notificações proativas"). Ficam documentadas aqui porque sem elas
# não há como completar a configuração:
#
#   TRELLO_BOARD_ID              -> vira o campo idModel do registro
#   TRELLO_WEBHOOK_CALLBACK_URL  -> vira o campo callbackURL (a URL pública
#                                   do seu túnel, ex: https://algo.trycloudflare.com/webhooks/trello)
TRELLO_BOARD_ID=
TRELLO_WEBHOOK_CALLBACK_URL=


# ------ Caminhos e persistência ----------------------------------------------
# OPCIONAL. Pasta do SEU computador com a documentação em Markdown que o
# agente de triagem consulta (PRD, ROADMAP, decisões de arquitetura).
#
# Se você deixar em branco, o sistema usa a pasta ./docs_sample que vem no
# repositório — assim o projeto sobe e funciona sem nenhum documento seu.
# Exemplos de valor real:
#   Windows:  SYNEREDUC_DOCS_PATH=D:/Portal Conexao/AVA/docs
#   Linux:    SYNEREDUC_DOCS_PATH=/home/junior/synereduc/docs
SYNEREDUC_DOCS_PATH=

# OPCIONAL. Diretório, DENTRO do container, onde o banco SQLite é gravado
# (checkpointer da conversa + memória de decisões). O padrão /app/data é
# onde o docker-compose.yml monta o volume nomeado que preserva os dados
# entre reconstruções. Só mude isto se for rodar fora do Docker.
DATA_DIR=/app/data
