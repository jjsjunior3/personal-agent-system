# ------ LLM Provider ----------------------------------
# Chave da OpenRouter, usado para acessar o Gemini 2.5 Flash com o custo controlado
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ------ Telegram --------------------------------------
# Token do seu bot, obitido através do @BotFather no telegram
TELEGRAM_BOT_TOKEN=

# ------ Modelos por função (opcional) -----------------
# Sem estas variáveis, roteamento, conversa e triagem usam a OpenRouter
# (OPENROUTER_API_KEY). Provedores aceitos: openrouter, openai. Ao trocar
# o provedor de uma função, informe também o modelo no formato daquele
# provedor. Não há fallback: chave ausente impede o startup da API.
# LLM_ROUTER_PROVIDER=openrouter
# LLM_ROUTER_MODEL=google/gemini-2.5-flash
# LLM_CHAT_PROVIDER=openrouter
# LLM_CHAT_MODEL=google/gemini-2.5-flash
# LLM_TRIAGE_PROVIDER=openrouter
# LLM_TRIAGE_MODEL=openai/gpt-5.4

# ------ Supervisor API --------------------------------
SUPERVISOR_API_PORT=8000

# ── OpenAI - usado apenas para transcrição de áudio (Whisper) ──
OPENAI_API_KEY=

#------ MCP Servers (preenchido nas próximas fases) ----------------------
# GITHUB_ TOKEN=
# GOOGLE_DRIVE_CREDENTIALS_PATH=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=
TRELLO_BACKLOG_LIST_ID=

TELEGRAM_CHAT_ID=
TRELLO_WEBHOOK_CALLBACK_URL=